---
import ButtonLink from "../components/ButtonLink.astro";
import Section from "../components/Section.astro";
import DownloadGroup from "../components/DownloadGroup.astro";
---

<Section id="header">
  <header id="header">
    <div class="content">
      <h1>
        <span>Hi, I am Suny Kim and I build data platforms in clouds.</span>
        <span class="accent">Master complexity, keep it simple.</span>
      </h1>
    </div>
    <img
      src="./images/sunydiana_stuhl_downsized.png"
      width="200"
      height="200"
      alt="Suny face"
    />
    <p class="description">
      As a Cloud Architect with 25+ years of in-house and consulting expertise,
      I design and build cloud systems. Data is always at the center, AI is part
      of the story, and CI/CD is where technology and processes converge.
    </p>
    <div class="button-container">
  <span class="downloads-heading">Downloads</span>
<DownloadGroup
  label="Resume"
  en="./resume_kim_202607.pdf"
  de="./lebenslauf_kim_202607.pdf"
/>
<DownloadGroup
  label="Project list"
  en="./projectlist_kim_202607.pdf"
  de="./projektliste_202607.pdf"
      />
    </div>
  </header>
</Section>

<style>
  #header {
    display: grid;
    grid-template-columns: 540px 1fr;
    justify-items: center;
    gap: 80px;
    align-items: center;
    img {
      border-radius: 5%;
    }
    h1 {
      font-size: 34px;
      display: flex;
      flex-direction: column;
      margin-bottom: 20px;

      .accent {
        color: var(--primary);
      }
    }
    .downloads-heading {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--primary);
    }

    .button-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

    .description {
      color: var(--dark);
      margin-bottom: 30px;
    }

    @media (max-width: 600px) {
      & {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 40px;

        img {
          grid-row: 1;
        }
      }
    }
</style>
